{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "640px",
			"wideSize": "1170px"
		},
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#ffffff"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#000000"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#5b6b74"
				},
				{
					"slug": "header",
					"name": "Header",
					"color": "#fafafa"
				},
				{
					"slug": "brand",
					"name": "Brand gray",
					"color": "#6b6b6b"
				},
				{
					"slug": "accent",
					"name": "Link",
					"color": "#0000ee"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body (Merriweather)",
					"fontFamily": "Merriweather, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Merriweather",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/merriweather-400.woff2"
							]
						},
						{
							"fontFamily": "Merriweather",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/merriweather-700.woff2"
							]
						}
					]
				},
				{
					"slug": "heading",
					"name": "Heading (Fira Sans)",
					"fontFamily": "\"Fira Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Fira Sans",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fira-sans-400.woff2"
							]
						},
						{
							"fontFamily": "Fira Sans",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fira-sans-600.woff2"
							]
						},
						{
							"fontFamily": "Fira Sans",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fira-sans-700.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "2.25rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.25rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "30",
					"name": "Small",
					"size": "0.75rem"
				},
				{
					"slug": "40",
					"name": "Medium",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "Large",
					"size": "2.5rem"
				},
				{
					"slug": "60",
					"name": "X-Large",
					"size": "4rem"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--muted)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "1rem",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"lineHeight": "1.25"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "2.5rem",
					"fontWeight": "700"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "2.5rem",
					"fontWeight": "700"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"fontSize": "1.75rem"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--brand)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/site-tagline": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"fontSize": "1.1rem"
				},
				"color": {
					"text": "#6b6b6b"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "1rem"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "2.5rem",
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-featured-image": {
				"border": {
					"radius": "0"
				}
			},
			"core/query-pagination": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)"
				}
			},
			"core/post-author": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "home-page",
			"title": "Home",
			"postTypes": [
				"page"
			]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
